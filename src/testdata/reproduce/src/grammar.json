{
  "name": "tsgk_owned",
  "rules": {
    "source_file": {"type": "REPEAT", "content": {"type": "SYMBOL", "name": "item"}},
    "item": {"type": "CHOICE", "members": [
      {"type": "SYMBOL", "name": "word"},
      {"type": "SYMBOL", "name": "number"},
      {"type": "SYMBOL", "name": "pair"}
    ]},
    "pair": {"type": "SEQ", "members": [
      {"type": "STRING", "value": "("},
      {"type": "FIELD", "name": "left", "content": {"type": "SYMBOL", "name": "word"}},
      {"type": "STRING", "value": ","},
      {"type": "FIELD", "name": "right", "content": {"type": "SYMBOL", "name": "number"}},
      {"type": "STRING", "value": ")"}
    ]},
    "word": {"type": "PATTERN", "value": "[a-z]+"},
    "number": {"type": "PATTERN", "value": "[0-9]+"}
  },
  "extras": [{"type": "PATTERN", "value": "\\s"}],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": []
}
