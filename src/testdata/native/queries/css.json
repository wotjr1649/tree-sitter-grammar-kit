  "queries": [
    {
      "id": "q.structure",
      "source": "(namespace_statement (namespace_name) @namespace)\n(declaration (property_name) @property)\n(feature_query (feature_name) @feature)\n(keyframes_statement (keyframes_name) @keyframes)\n"
    },
    {
      "id": "q.property",
      "source": "(declaration (property_name) @property)\n"
    },
    {
      "id": "q.value",
      "source": "(declaration [(plain_value) (integer_value) (float_value) (color_value) (string_value) (call_expression) (binary_expression) (grid_value) (parenthesized_value)] @value)\n"
    },
    {
      "id": "q.call",
      "source": "(call_expression (function_name) @function)\n(arguments [(plain_value) (integer_value) (float_value) (color_value) (string_value) (call_expression)] @arg)\n"
    },
    {
      "id": "q.selectors",
      "source": "(class_selector (class_name) @class)\n(attribute_selector (attribute_name) @attribute)\n(pseudo_class_selector (class_name) @pseudo_class)\n(pseudo_element_selector (tag_name) @pseudo_element .)\n"
    },
    {
      "id": "q.import",
      "source": "(import_statement (call_expression (function_name) @function))\n(import_statement (keyword_query) @media_type)\n"
    },
    {
      "id": "q.calc",
      "source": "(binary_expression (binary_expression) @operand)\n"
    },
    {
      "id": "q.at",
      "source": "(at_rule (at_keyword) @at_keyword)\n(at_rule (keyword_query) @prelude)\n"
    },
    {
      "id": "q.media",
      "source": "(binary_query) @condition\n(feature_name) @feature\n"
    },
    {
      "id": "q.grid",
      "source": "(grid_value) @line_names\n(call_expression (function_name) @function)\n"
    },
    {
      "id": "q.supports",
      "source": "(selector_query (child_selector) @selector)\n"
    }
  ],
