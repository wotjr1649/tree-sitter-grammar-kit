      "source_utf8": "# Inventory helpers\nlibrary(stats)\n\nitems <- data.frame(\n  name = c(\"bolt\", \"nut\", \"washer\"),\n  count = c(120L, 4L, 0L),\n  stringsAsFactors = FALSE\n)\n\nlevel <- function(count, threshold = 100) {\n  if (is.na(count)) {\n    return(NA_character_)\n  } else if (count > threshold) {\n    \"bulk\"\n  } else {\n    \"normal\"\n  }\n}\n\nsummarise <- function(df, ...) {\n  total <- 0\n  for (i in seq_len(nrow(df))) {\n    total <- total + df$count[[i]]\n  }\n  list(total = total, levels = vapply(df$count, level, character(1), ...))\n}\n\nsquares <- sapply(items$count, \\(x) x^2)\nresult <- items |> subset(count > 0) |> summarise()\nwhile (FALSE) next\nrepeat {\n  break\n}\nprint(result[[\"total\"]])\n",
      "edits": [
        {
          "find": "  stringsAsFactors = FALSE\n)\n",
