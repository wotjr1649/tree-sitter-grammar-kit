      "source_utf8": "<!DOCTYPE html>\n<html>\n<body>\n<h1>Inventory</h1>\n<?php\nenum Level: string\n{\n    case Low = 'low';\n    case High = 'high';\n}\n\nfinal class Item\n{\n    public function __construct(\n        public readonly string $name,\n        private int $count = 0,\n    ) {}\n\n    public function count(): int\n    {\n        return $this->count;\n    }\n}\n\nfunction level(?Item $item): Level\n{\n    $count = $item?->count() ?? 0;\n    return match (true) {\n        $count > 100 => Level::High,\n        default => Level::Low,\n    };\n}\n\n$items = [new Item('bolt', 120), new Item(name: 'nut', count: 4)];\n$total = array_sum(array_map(fn(Item $i): int => $i->count(), $items));\nforeach ($items as $i => $item) {\n    // Print one row per item.\n    echo \"<p>{$item->name}: \" . level($item)->value . \"</p>\\n\";\n}\n?>\n<footer>Total: <?= $total ?></footer>\n</body>\n</html>\n",
