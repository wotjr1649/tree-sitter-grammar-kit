      "features": ["postgresql-sql-V13", "postgresql-sql-V16", "S05/S03: 후보가 PostgreSQL 19 기반이며 채택 범위 9.6–18 checkpoint별 지원은 미검증"],
      "source_utf8": "SELECT 1;\nMERGE INTO t USING s ON t.id = s.id\nWHEN MATCHED THEN UPDATE SET v = s.v\nWHEN NOT MATCHED THEN INSERT (id, v) VALUES (s.id, s.v);\n",
      "edits": [
        {"find": "VALUES (s.id, s.v);", "replace": "VALUES (s.id, s.v) RETURNING merge_action(), t.id;"},
