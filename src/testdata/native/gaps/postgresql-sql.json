      "features": ["postgresql-sql-V10", "S05/S03: 후보가 PostgreSQL 19 기반이며 채택 범위 9.6–18 checkpoint별 지원은 미검증"],
      "source_utf8": "SELECT 1;\nCREATE PROCEDURE p(a int) LANGUAGE sql AS $$ SELECT a $$;\nCALL p(1);\n",
      "edits": [
        {"find": "CALL p(1);", "replace": "CALL p(1;"},
        {"find": "CALL p(1;", "replace": "CALL p(1);"}
      ],
      "expect": [
