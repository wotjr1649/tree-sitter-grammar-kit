      "id": "tsql-gap-merge-output-r1",
      "kind": "gap",
      "features": ["tsql-B02", "S05/S03: tsql-B01..B05·V16·V22는 등록 행 PASS이나 전체 statement 범위는 bounded"],
      "source_utf8": "SELECT 1 AS anchor;\nMERGE INTO dbo.t AS tgt\nUSING dbo.s AS src ON tgt.id = src.id\nWHEN MATCHED THEN UPDATE SET tgt.v = src.v\nWHEN NOT MATCHED BY TARGET THEN INSERT (id, v) VALUES (src.id, src.v)\nWHEN NOT MATCHED BY SOURCE THEN DELETE\nOUTPUT $action, inserted.id;\n",
      "edits": [
        {"find": "BY SOURCE THEN DELETE", "replace": "BY SOURCE THEN"},
        {"find": "BY SOURCE THEN", "replace": "BY SOURCE THEN DELETE"}
      ],
      "expect": [
        {"step": 0, "syntax": "NO_ERROR", "contains": ["merge", "merge_when_clause", "output_clause"], "declarations": ""},
        {"step": 1, "syntax": "ERROR", "contains": [], "declarations": ""},
        {"step": 2, "syntax": "NO_ERROR", "contains": ["merge", "merge_when_clause", "output_clause"], "declarations": ""}
      ]
    },
