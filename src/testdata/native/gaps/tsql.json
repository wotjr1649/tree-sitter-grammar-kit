      "kind": "gap",
      "features": ["tsql-B02", "S05/S03: tsql-B01..B05·V16·V22는 등록 행 PASS이나 전체 statement 범위는 bounded"],
      "source_utf8": "SELECT 1 AS anchor;\nSELECT id,\n       ROW_NUMBER() OVER (PARTITION BY g ORDER BY id) AS rn,\n       LAG(v, 1, 0) OVER (PARTITION BY g ORDER BY id) AS prev_v,\n       SUM(v) OVER (ORDER BY id ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS running\nFROM dbo.t;\n",
