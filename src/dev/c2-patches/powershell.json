          "after": "\nstatic bool is_dash(int32_t c) { return c == '-' || (c >= 0x2013 && c <= 0x2015); }\n\nstatic bool is_argument_delimiter(int32_t c)\n{\n    return c == 0 || iswspace(c) || c == '&' || c == '(' || c == ')' || c == '}' || c == '|' || c == ';' || c == ',';\n}\n\n// In command element position: END_OF_PARAMETERS is the dashdash '--' followed by\n// whitespace or the end of input ('--$x', '--%' and '--name' stay grammar tokens), and\n// after it END_OF_PARAMETERS_ARGUMENT is a dash-led argument word, which is then never a\n// parameter or an operator.\nstatic bool scan_end_of_parameters(TSLexer *lexer, const bool *valid_symbols)\n{\n    unsigned n = 0;\n    bool dashes = true;\n    while (!is_argument_delimiter(lexer->lookahead)) {\n        if (n < 2 && !is_dash(lexer->lookahead)) dashes = false;\n        lexer->advance(lexer, false);\n        n++;\n    }\n    lexer->mark_end(lexer);\n    if (valid_symbols[END_OF_PARAMETERS] && n == 2 && dashes && (lexer->lookahead == 0 || iswspace(lexer->lookahead))) {\n        lexer->result_symbol = END_OF_PARAMETERS;\n        return true;\n    }\n    if (valid_symbols[END_OF_PARAMETERS_ARGUMENT]) {\n        lexer->result_symbol = END_OF_PARAMETERS_ARGUMENT;\n        return true;\n    }\n    return false;\n}\n\n/* --- API Implementation --- */\n",
